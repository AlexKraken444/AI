{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/chat.py": {
      "maxDuration": 60,
      "includeFiles": "neural/**",
      "excludeFiles": "{.local-runtime/**,.local-models/**,.gpu-state/**,scripts/**,.training-libs/**,training-data/**,training-output/**,training/**,tests/**,train.py,train_transformer.py}"
    }
  },
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]
  }]
}
